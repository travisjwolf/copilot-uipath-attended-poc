{
  "swagger": "2.0",
  "info": {
    "title": "Copilot UiPath Attended Bridge",
    "description": "Starts and monitors the allowlisted synthetic UiPath attended proof-of-concept process through a localhost bridge.",
    "version": "1.0.0"
  },
  "host": "127.0.0.1:5211",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "name": "X-Api-Key",
      "in": "header"
    }
  },
  "paths": {
    "/api/jobs": {
      "post": {
        "operationId": "StartUiPathAttendedJob",
        "summary": "Start an attended UiPath job",
        "description": "Starts the fixed CopilotAttendedPoC process with synthetic inputs. Generate the idempotency key and timestamp in the calling flow, not from agent text.",
        "x-ms-summary": "Start UiPath attended job",
        "x-ms-visibility": "important",
        "security": [
          {
            "api_key": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "One GUID generated once per flow invocation and reused for retries.",
            "required": true,
            "type": "string",
            "maxLength": 200,
            "x-ms-summary": "Idempotency key",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "X-Request-Timestamp",
            "in": "header",
            "description": "Current UTC timestamp in ISO-8601 format, generated by the flow.",
            "required": true,
            "type": "string",
            "format": "date-time",
            "x-ms-summary": "Request timestamp",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/StartJobRequest"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "The attended job request was accepted.",
            "schema": {
              "$ref": "#/definitions/StartJobAccepted"
            }
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/responses/NotFound"
          },
          "408": {
            "$ref": "#/responses/ExpiredRequest"
          },
          "409": {
            "$ref": "#/responses/Conflict"
          },
          "413": {
            "$ref": "#/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/jobs/{requestId}": {
      "get": {
        "operationId": "GetUiPathAttendedJobStatus",
        "summary": "Get attended UiPath job status",
        "description": "Returns the current status and safe output for a bridge-generated request identifier.",
        "x-ms-summary": "Get UiPath attended job status",
        "x-ms-visibility": "important",
        "security": [
          {
            "api_key": []
          }
        ],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "description": "The request identifier returned by StartUiPathAttendedJob.",
            "required": true,
            "type": "string",
            "format": "uuid",
            "x-ms-summary": "Request ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Current job status.",
            "schema": {
              "$ref": "#/definitions/JobStatus"
            }
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/responses/NotFound"
          }
        }
      }
    },
    "/api/jobs/{requestId}/cancel": {
      "post": {
        "operationId": "CancelUiPathAttendedJob",
        "summary": "Cancel an attended UiPath job",
        "description": "Requests cancellation for a pending or running attended job.",
        "x-ms-summary": "Cancel UiPath attended job",
        "x-ms-visibility": "important",
        "security": [
          {
            "api_key": []
          }
        ],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "description": "The request identifier returned by StartUiPathAttendedJob.",
            "required": true,
            "type": "string",
            "format": "uuid",
            "x-ms-summary": "Request ID"
          }
        ],
        "responses": {
          "202": {
            "description": "Cancellation was accepted.",
            "schema": {
              "$ref": "#/definitions/JobStatus"
            }
          },
          "401": {
            "$ref": "#/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/responses/NotFound"
          },
          "409": {
            "$ref": "#/responses/Conflict"
          }
        }
      }
    }
  },
  "responses": {
    "BadRequest": {
      "description": "The request schema or inputs are invalid.",
      "schema": {
        "$ref": "#/definitions/ErrorResponse"
      }
    },
    "Unauthorized": {
      "description": "The API key is missing or invalid.",
      "schema": {
        "$ref": "#/definitions/ErrorResponse"
      }
    },
    "NotFound": {
      "description": "The process alias or request identifier was not found.",
      "schema": {
        "$ref": "#/definitions/ErrorResponse"
      }
    },
    "ExpiredRequest": {
      "description": "The request timestamp has expired.",
      "schema": {
        "$ref": "#/definitions/ErrorResponse"
      }
    },
    "Conflict": {
      "description": "The idempotency key conflicts or the job is not cancellable.",
      "schema": {
        "$ref": "#/definitions/ErrorResponse"
      }
    },
    "PayloadTooLarge": {
      "description": "The request exceeds a configured size limit.",
      "schema": {
        "$ref": "#/definitions/ErrorResponse"
      }
    },
    "TooManyRequests": {
      "description": "Another attended job is already active.",
      "schema": {
        "$ref": "#/definitions/ErrorResponse"
      }
    }
  },
  "definitions": {
    "StartJobRequest": {
      "type": "object",
      "required": [
        "processAlias",
        "requestedBy",
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "processAlias": {
          "type": "string",
          "enum": [
            "CopilotAttendedPoC"
          ],
          "default": "CopilotAttendedPoC",
          "description": "Fixed allowlisted process alias.",
          "x-ms-summary": "Process alias",
          "x-ms-visibility": "internal"
        },
        "requestedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "Synthetic caller label supplied by the agent flow.",
          "x-ms-summary": "Requested by"
        },
        "inputs": {
          "$ref": "#/definitions/AllowedInputs"
        }
      }
    },
    "AllowedInputs": {
      "type": "object",
      "required": [
        "in_Message",
        "in_RequestedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "in_Message": {
          "type": "string",
          "maxLength": 4096,
          "description": "Synthetic message displayed by the attended demonstration.",
          "x-ms-summary": "Synthetic message"
        },
        "in_RequestedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "Synthetic caller label passed to the UiPath process.",
          "x-ms-summary": "Requested by"
        }
      }
    },
    "StartJobAccepted": {
      "type": "object",
      "required": [
        "requestId",
        "status",
        "message"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "Accepted"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "JobStatus": {
      "type": "object",
      "required": [
        "requestId",
        "processAlias",
        "status",
        "createdUtc"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "processAlias": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "Pending",
            "Running",
            "Completed",
            "Failed",
            "Cancelled"
          ]
        },
        "createdUtc": {
          "type": "string",
          "format": "date-time"
        },
        "startedUtc": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true
        },
        "completedUtc": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true
        },
        "result": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-nullable": true
        },
        "error": {
          "type": "string",
          "x-nullable": true
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      }
    }
  }
}
