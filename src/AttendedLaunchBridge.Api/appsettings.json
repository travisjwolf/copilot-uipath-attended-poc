{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5211"
      }
    }
  },
  "Bridge": {
    "ApiKeyHeaderName": "X-Api-Key",
    "IdempotencyKeyHeaderName": "Idempotency-Key",
    "RequestTimestampHeaderName": "X-Request-Timestamp",
    "CorrelationIdHeaderName": "X-Correlation-ID",
    "RequestMaxAgeSeconds": 300,
    "AllowedClockSkewSeconds": 30,
    "MaxRequestBodyBytes": 16384,
    "MaxInputCount": 10,
    "MaxInputNameLength": 100,
    "MaxInputValueLength": 4096,
    "MaxTotalInputCharacters": 8192,
    "MaxRequestedByLength": 128,
    "MaxProcessAliasLength": 100,
    "MaxIdempotencyKeyLength": 200,
    "MaxConcurrentJobs": 1,
    "IdempotencyRetentionMinutes": 1440
  },
  "UiPath": {
    "UseFakeRobotClient": false,
    "FakeStartDelayMs": 100,
    "FakeExecutionDelayMs": 500,
    "AllowedProcesses": {
      "CopilotAttendedPoC": {
        "RobotProcessName": "CopilotAttendedPoC",
        "AllowedInputs": [
          "in_RequestId",
          "in_Message",
          "in_RequestedBy"
        ]
      }
    }
  }
}
