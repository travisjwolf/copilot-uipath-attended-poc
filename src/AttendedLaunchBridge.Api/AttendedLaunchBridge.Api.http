  "processAlias": "CopilotAttendedPoC",
  "requestedBy": "synthetic-test-user",
  "inputs": {
    "in_Message": "This synthetic attended automation was requested locally.",
    "in_RequestedBy": "synthetic-test-user"
  }
}

