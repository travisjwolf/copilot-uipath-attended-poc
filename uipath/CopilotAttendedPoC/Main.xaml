        <ui:InvokeCode Code="If String.IsNullOrWhiteSpace(in_Message) Then&#xD;&#xA;    Throw New System.ArgumentException(&quot;in_Message is required.&quot;)&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;Dim requestGuid As System.Guid&#xD;&#xA;If Not System.Guid.TryParse(in_RequestId, requestGuid) Then&#xD;&#xA;    Throw New System.ArgumentException(&quot;in_RequestId must be a GUID.&quot;)&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;Dim fileName As String = &quot;CopilotAttendedPoC-&quot; &amp; requestGuid.ToString(&quot;N&quot;) &amp; &quot;.txt&quot;&#xD;&#xA;Dim filePath As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), fileName)&#xD;&#xA;System.IO.File.WriteAllText(filePath, in_Message, New System.Text.UTF8Encoding(False))&#xD;&#xA;&#xD;&#xA;Dim startInfo As New System.Diagnostics.ProcessStartInfo(&quot;notepad.exe&quot;) With { .UseShellExecute = True }&#xD;&#xA;startInfo.ArgumentList.Add(filePath)&#xD;&#xA;If System.Diagnostics.Process.Start(startInfo) Is Nothing Then&#xD;&#xA;    Throw New System.InvalidOperationException(&quot;Notepad could not be started.&quot;)&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;Dim targetWindow As System.Diagnostics.Process = Nothing&#xD;&#xA;Dim windowDeadline As System.DateTime = System.DateTime.UtcNow.AddSeconds(10)&#xD;&#xA;Do&#xD;&#xA;    For Each candidate As System.Diagnostics.Process In System.Diagnostics.Process.GetProcessesByName(&quot;notepad&quot;)&#xD;&#xA;        candidate.Refresh()&#xD;&#xA;        If candidate.MainWindowHandle &lt;&gt; System.IntPtr.Zero AndAlso candidate.MainWindowTitle.IndexOf(fileName, System.StringComparison.OrdinalIgnoreCase) &gt;= 0 Then&#xD;&#xA;            targetWindow = candidate&#xD;&#xA;            Exit For&#xD;&#xA;        End If&#xD;&#xA;    Next&#xD;&#xA;&#xD;&#xA;    If targetWindow Is Nothing Then&#xD;&#xA;        System.Threading.Thread.Sleep(200)&#xD;&#xA;    End If&#xD;&#xA;Loop While targetWindow Is Nothing AndAlso System.DateTime.UtcNow &lt; windowDeadline&#xD;&#xA;&#xD;&#xA;If targetWindow Is Nothing Then&#xD;&#xA;    Throw New System.TimeoutException(&quot;The synthetic Notepad window was not found.&quot;)&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;out_Result = &quot;Synthetic Notepad demonstration completed for request &quot; &amp; in_RequestId &amp; &quot;.&quot;" ContinueOnError="{x:Null}" DisplayName="Open Notepad and Display Synthetic Message" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
